          "trigger": "Manual",
          "nodes": [
            {
              "id": "3b7b1ce3-3729-5eb3-98da-9210db99ad68",
              "name": "Start",
              "label": "Manual",
              "family": "trigger",
              "x": 0,
              "y": 0,
              "args": {
                "resources": [
                  "incidents"
                ],
                "title": "Sync to ticketing"
              }
            },
            {
              "id": "4da01451-25a7-516e-b287-49f3e580a006",
              "name": "Build ticket body",
              "label": "Set Variable",
              "family": "utility",
              "x": 0,
              "y": 0,
              "args": {
                "summary": "{{ vars.input.records[0].name }}",
                "priority": "{{ vars.input.records[0].severity.itemValue }}"
              }
            },
            {
              "id": "36dbe69a-5b47-5e9b-a971-cb2ca65cb318",
              "name": "Create ticket",
              "label": "Connector",
              "family": "connector",
              "x": 0,
              "y": 0,
              "args": {
                "connector": "acme-ticketing",
                "operation": "create_ticket",
                "params": {
                  "title": "{{ vars.summary }}",
                  "priority": "{{ vars.priority }}"
                }
              },
              "connector": "acme-ticketing",
              "operation": "create_ticket"
            },
            {
              "id": "ab3697db-1cca-5d2c-a616-f7eaa79e2fe1",
              "name": "Store ticket ID",
              "label": "Update Record",
              "family": "record",
              "x": 0,
              "y": 0,
              "args": {
                "resource": {
                  "externalTicketId": "{{ vars.steps.Create_ticket.data.id }}"
                }
              }
            },
            {
              "id": "2acbe076-e8b6-5dc9-9daf-1273e428788c",
              "name": "Notify owner",
              "label": "Send Email",
              "family": "human",
              "x": 0,
              "y": 0,
              "args": {
                "to": "{{ vars.input.records[0].assignedTo.email }}",
                "subject": "Ticket created"
              }
            }
