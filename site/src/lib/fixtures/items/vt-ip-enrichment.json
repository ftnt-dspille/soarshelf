  "collections": [
    {
      "name": "IP Enrichment",
      "description": "Source IP reputation.",
      "playbooks": [
        {
          "name": "Enrich source IP with VirusTotal",
          "description": "Looks up the alert's source IP and sets severity from the detection count.",
          "trigger": "On Create",
          "nodes": [
            {
              "id": "0af487f2-eeaf-5eaa-8b77-fb64ccb92e01",
              "name": "Start",
              "label": "On Create",
              "family": "trigger",
              "x": 30,
              "y": 30,
              "args": {
                "resource": "alerts",
                "fieldbasedtrigger": {
                  "logic": "AND",
                  "filters": [
                    {
                      "field": "sourceIp",
                      "operator": "isnull",
                      "value": "false"
                    }
                  ]
                }
              }
            },
            {
              "id": "c952d3b9-5a93-5f17-a538-26b2ef346567",
              "name": "Extract source IP",
              "label": "Set Variable",
              "family": "utility",
              "x": 30,
              "y": 170,
              "args": {
                "source_ip": "{{ vars.input.records[0].sourceIp }}"
              }
            },
            {
              "id": "8689e737-c788-5e70-8594-3e06f3de7450",
              "name": "Is IP public?",
              "label": "Decision",
              "family": "decision",
              "x": 30,
              "y": 310,
              "args": {
                "conditions": [
                  {
                    "option": "Public",
                    "condition": "{{ vars.source_ip | ipaddr('public') }}"
                  },
                  {
                    "option": "Private",
                    "default": true
                  }
                ]
              }
            },
            {
              "id": "dcebd18b-e968-55b6-a8ef-11a7e6577d86",
              "name": "Get IP reputation",
              "label": "Connector",
              "family": "connector",
              "x": -160,
              "y": 460,
              "args": {
                "connector": "virustotal",
                "operation": "get_ip_reputation",
                "params": {
                  "ip": "{{ vars.source_ip }}"
                },
                "config": ""
              },
              "connector": "virustotal",
              "operation": "get_ip_reputation"
            },
            {
              "id": "f2d9fc6a-7304-57c2-a2c1-9c4fc14ae4db",
              "name": "Update alert severity",
              "label": "Update Record",
              "family": "record",
              "x": -160,
              "y": 610,
              "args": {
                "resource": {
                  "severity": "{{ 'High' if vars.steps.Get_IP_reputation.data.attributes.last_analysis_stats.malicious > 3 else 'Low' }}"
                },
                "collection": "{{ vars.input.records[0]['@id'] }}"
              }
            },
            {
              "id": "d870d65c-9f3d-522e-8bf6-b0c10c493e41",
              "name": "Skip private IP",
              "label": "No Operation",
              "family": "utility",
              "x": 220,
              "y": 460,
              "args": {}
            }
          ],
