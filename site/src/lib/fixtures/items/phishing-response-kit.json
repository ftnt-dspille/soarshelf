  "collections": [
    {
      "name": "Phishing - Investigate",
      "description": "Investigation playbooks.",
      "playbooks": [
        {
          "name": "Investigate reported email",
          "description": "Parses a reported email, scans URLs and asks an analyst.",
          "trigger": "Manual",
          "nodes": [
            {
              "id": "a749674a-a8e7-5406-93c8-97dca587255c",
              "name": "Start",
              "label": "Manual",
              "family": "trigger",
              "x": 30,
              "y": 30,
              "args": {
                "resources": [
                  "alerts"
                ]
              }
            },
            {
              "id": "b89f39fc-83ba-5bcb-bd78-0e87d42ba8dd",
              "name": "Parse email headers",
              "label": "Code Snippet",
              "family": "code",
              "x": 30,
              "y": 170,
              "args": {
                "python_function": "import email\nmsg = email.message_from_string(vars['raw'])\nprint({'from': msg['From'], 'urls': []})"
              },
              "connector": "cyops_utilities",
              "operation": "code_snippet"
            },
            {
              "id": "bdc75cb7-e850-53da-b360-d7c286a15e10",
              "name": "Scan URLs",
              "label": "Connector",
              "family": "connector",
              "x": 30,
              "y": 310,
              "args": {
                "connector": "urlscan-io",
                "operation": "submit_url",
                "params": {
                  "url": "{{ vars.steps.Parse_email_headers.data.urls[0] }}"
                }
              },
              "connector": "urlscan-io",
              "operation": "submit_url"
            },
            {
              "id": "749e0ea3-84fc-5147-bea8-f7d7f09f2914",
              "name": "Analyst verdict",
              "label": "Manual Input",
              "family": "human",
              "x": 30,
              "y": 450,
              "args": {
                "title": "Is this phishing?",
                "options": [
                  "Malicious",
                  "Benign"
                ]
              }
            },
            {
              "id": "8b5fbd90-aabd-5c82-b4e1-7f30d049df1d",
              "name": "Malicious?",
              "label": "Decision",
              "family": "decision",
              "x": 30,
              "y": 590,
              "args": {}
            },
            {
