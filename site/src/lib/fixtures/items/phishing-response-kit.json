              "label": "Connector",
              "family": "connector",
              "x": 30,
              "y": 170,
              "args": {
                "connector": "smtp",
                "operation": "send_email",
                "params": {
                  "to": "{{ vars.mail_admins }}",
                  "subject": "Block sender {{ vars.sender }}"
