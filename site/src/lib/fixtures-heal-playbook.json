 "groups": [
  {
   "id": "31adc29f-74ee-53b8-8890-08b0453440ca",
   "kind": "note",
   "name": "Note: ResolvePath",
   "text": "The Vault path of the secret holding the key, and the field it is stored in.",
   "anchor": "ee27d413-a39b-515a-8784-5aecb6ffc75b"
  },
  {
   "id": "455e7dfc-a5ff-5fb9-aecf-92bd5cae8868",
   "kind": "note",
   "name": "Note: KeyValid",
   "text": "Branch on the data-plane verdict for the stored key.",
   "anchor": "51cb83cf-19fc-5d4c-9420-2ae732d0f1ae"
  },
  {
   "id": "6b13035a-490d-5330-bb8c-bef37b07af11",
   "kind": "note",
   "name": "Note: ReplaceKey",
   "text": "An expired, revoked or suspended key cannot be rotated, so this issues a replacement key (an active key would be rotated in place).",
   "anchor": "b175a5d3-9e2a-5358-9d3f-dae0998f2e56"
  },
  {
   "id": "4f2a4394-6978-5a37-9f0f-0435789a220b",
   "kind": "note",
   "name": "Note: BuildPayload",
   "text": "KV v2 writes create a new version and drop omitted fields, so the new secret data is the whole current secret with only the key field replaced. Built as a JSON string because connector params are strings.",
   "anchor": "84314bf7-a8b3-5227-b0ba-83b4cee1a0e8"
  },
  {
   "id": "0f4d775a-1fd6-5f0c-8a07-876b2434cf7e",
   "kind": "note",
   "name": "Note: NewKeyValid",
   "text": "The rotated key must validate; anything else fails the run.",
   "anchor": "e8757c3d-50bb-5fed-bc54-2b006c1dcdf4"
  },
  {
   "id": "8bbb6a68-437e-58c6-a07c-6618ad15e4e0",
   "kind": "note",
   "name": "Note: FailRotation",
   "text": "Reachable only when the rotated key does not validate.",
   "anchor": "e880b871-3306-5bca-b235-32df9e0a0f14"
  },
  {
