        {
            "operation": "get_clusters",
            "category": "investigation",
            "annotation": "get_clusters",
            "description": "Retrieves a list of clusters from Cofense Triage based on the input parameters you have specified. NOTE: If you do not specify any input parameters, then this operation will retrieve all clusters from Cofense Triage.",
            "title": "Get Clusters",
            "parameters": [
                {
                    "title": "Priority",
                    "type": "integer",
                    "name": "match_priority",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Priority value should be between 0 to 5."
                },
                {
                    "title": "Created At",
                    "type": "datetime",
                    "name": "created_at",
                    "required": false,
                    "visible": true,
                    "editable": true
                },
                {
                    "title": "Updated At",
                    "type": "datetime",
                    "name": "updated_at",
                    "required": false,
                    "visible": true,
                    "editable": true
                },
                {
                    "title": "Page",
                    "type": "integer",
                    "name": "page_number",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "value": 1,
                    "tooltip": "Value should not be negative"
                },
                {
                    "title": "Number of Results to Fetch",
                    "type": "integer",
                    "name": "page_size",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "value": 20,
                    "tooltip": "Specify the number of results this operation returns, per page, in the response. The maximum number of results per page is set items to 200."
                },
                {
                    "title": "Sort By",
                    "type": "text",
                    "name": "sort_by",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Specify the attributes to sort the clusters. Note: The default sort order for an attribute is ascending. Prefix the attributes with a hyphen to sort in descending order."
                },
                {
                    "title": "Filter By",
                    "type": "json",
                    "name": "filter_by",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Specify the filters to filter the list of clusters by attribute values. Note: Enter values in key-value JSON format.For Example {\"risk_score_eq\": \"1\"}."
                },
                {
                    "title": "Fields to Retrieve",
                    "type": "text",
                    "name": "fields_to_retrieve",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Specify the fields to retrieve the mentioned attributes only. For example: unprocessed_reports_count, processed_reports_count."
                },
                {
                    "title": "Count",
                    "type": "integer",
                    "name": "total_reports_count",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Specify the number of reports to be present in the cluster."
                },
                {
                    "title": "Tags",
                    "type": "text",
                    "name": "tags",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Specify the tags to retrieve the cluster."
                }
            ],
            "output_schema": {},
            "enabled": true,
            "open": false
        },
