{
    "name": "proofpoint-email-gateway_dev",
    "version": "2.0.1",
    "label": "Proofpoint Email Gateway - Updated",
    "description": "Proofpoint Email Protection helps you secure and control inbound and outbound email through an easy-to-use cloud-based solution. Perform actions like organizational block list and search quarantine message information using Proofpoint Email Gateway.",
    "publisher": "Nikitha Nagwan",
    "icon_small_name": "proofpoint_small.png",
    "icon_large_name": "proofpoint_large.png",
    "id": 41,
    "configuration": {
        "fields": [
            {
                "title": "Server URL",
                "type": "text",
                "name": "server_url",
                "required": true,
                "visible": true,
                "editable": true,
                "tooltip": "URL of the Proofpoint Email Gateway server to which you will connect and perform automated operations."
            },
            {
                "title": "API Key",
                "type": "password",
                "name": "api_key",
                "required": true,
                "visible": true,
                "editable": true,
                "tooltip": "Specify the API key to authenticate and perform automated operations on the Proofpoint Email Gateway endpoint."
            },
            {
                "title": "Secret",
                "type": "password",
                "name": "secret",
                "required": true,
                "visible": true,
                "editable": true,
                "tooltip": "Specify the Secret to authenticate and perform automated operations on the Proofpoint Email Gateway endpoint."
            },
            {
                "title": "Verify SSL",
                "type": "checkbox",
                "name": "verify_ssl",
                "required": false,
                "visible": true,
                "editable": true,
                "value": true,
                "tooltip": "Specifies whether the SSL certificate for the server is to be verified. By default, this option is selected, i.e., set to 'True'."
            }
        ]
    },
    "operations": [
        {
            "operation": "search_quarantine_messages",
            "title": "Search Quarantine Messages (Deprecated)",
            "description": "Searches for quarantined messages on your Proofpoint Email Gateway server, based on input parameters, such as the email address of the sender of the message, the subject of the message, the query ID of the messager, etc, that you have specified.",
            "enabled": true,
            "category": "investigation",
            "annotation": "search_quarantine_messages",
            "parameters": [
                {
                    "title": "Messages",
                    "type": "multiselect",
                    "name": "message",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "From or Receipt or Subject must be specified",
                    "onchange": {
                        "From": [
                            {
                                "title": "From",
                                "description": "Specify the envelope address of the sender based on which you want to retrieve quarantined messages from the Proofpoint Email Gateway server.",
                                "type": "text",
                                "name": "from",
                                "required": true,
                                "editable": true,
                                "visible": true,
                                "placeholder": "e.g abc@example.com"
                            }
                        ],
                        "Receipt": [
                            {
                                "title": "Receipt",
                                "description": "Specify a list of envelope addresses of the recipients based on which you want to retrieve quarantined messages from the Proofpoint Email Gateway server.",
                                "type": "text",
                                "name": "rcpt",
                                "required": true,
                                "editable": true,
                                "visible": true,
                                "placeholder": "e.g abc@example.com"
                            }
                        ],
                        "Subject": [
                            {
                                "title": "Subject",
                                "description": "Specify the subject text based on which you want to retrieve quarantined messages from the Proofpoint Email Gateway server.",
                                "type": "text",
                                "name": "subject",
                                "required": true,
                                "editable": true,
                                "visible": true,
                                "tooltip": "Mime-decoded and URL-encoded utf8 text are supported",
                                "placeholder": "e.g Team Meeting or Meeting*"
                            }
                        ]
                    }
                },
                {
                    "title": "Query ID",
                    "type": "text",
                    "name": "queryid",
                    "required": false,
                    "visible": true,
                    "editable": true
                },
                {
                    "title": "Start Date",
                    "type": "datetime",
                    "name": "start_date",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Defaults to the last 24 hours if neither startdate nor enddate is specified. Note: Start date and time should be in UTC format only."
                },
                {
                    "title": "End Date",
                    "type": "datetime",
                    "name": "end_date",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Defaults to the last 24 hours if neither startdate nor enddate is specified.UTC timedate format. Note: Start date and time should be in UTC format only."
                },
                {
                    "title": "Folder",
                    "type": "text",
                    "name": "folder",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Defaults to \"Quarantine folder\",if no folder is specified"
                },
                {
                    "title": "Global Unique Identifier",
                    "type": "text",
                    "name": "guid",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "tooltip": "If it is specified and a message is found, the response body contains the message\u2019s raw data instead of a JSON document"
                },
                {
                    "title": "DLP Violation",
                    "type": "select",
                    "name": "dlpviolation",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "options": [
                        "Number of Smart Identifiers",
                        "Actual Smart Identifiers"
                    ]
                },
                {
                    "title": "Message Status",
                    "type": "checkbox",
                    "name": "messagestatus",
                    "required": false,
                    "visible": true,
                    "editable": true
                }
            ],
            "output_schema": {
                "count": "",
                "records": [
                    {
                        "processingserver": "",
                        "date": "",
                        "subject": "",
                        "messageid": "",
                        "folder": "",
                        "size": "",
                        "rcpts": [],
                        "from": "",
                        "spamscore": "",
                        "guid": "",
                        "host_ip": "",
                        "localguid": ""
                    }
                ],
                "meta": {
                    "fqin": "",
                    "queryid": "",
                    "query_params": {
                        "pretty": "",
                        "subject": "",
                        "from": ""
                    },
                    "limit": "",
                    "duration": ""
                }
            },
            "open": false
        },
        {
            "operation": "quarantine_message_actions",
            "title": "Quarantine Message Actions (Deprecated)",
            "description": "Performs actions such as release, forward, move, etc on specified quarantine messages on your Proofpoint Email Gateway server, based on the quarantine folder, local GUID, and action specified.",
            "enabled": true,
            "category": "investigation",
            "annotation": "quarantine_message_actions",
            "parameters": [
                {
                    "title": "Action to Process the Message",
                    "type": "select",
                    "name": "message",
                    "required": true,
                    "visible": true,
                    "editable": true,
                    "options": [
                        "Release Message",
                        "Resubmit Message",
                        "Forward Message",
                        "Move Message",
                        "Delete Message"
                    ],
                    "onchange": {
                        "Release Message": [
                            {
                                "title": "Deleted Folder",
                                "description": "(Optional) Folder for deleting the quarantined messages. If specified, the folder for deleted messages must be for quarantined messages of the same type of module. For example, you cannot send deleted 'Spam' messages to a folder for deleted 'DLP Incidents', and vice versa.",
                                "type": "text",
                                "name": "deletedfolder",
                                "required": false,
                                "editable": true,
                                "visible": true,
                                "placeholder": "e.g Deleted Incidents"
                            },
                            {
                                "title": "Rescan",
                                "description": "Select this option to rescan the message using the DLP and Attachment Defense filtering modules. By default, this is set to 'False'.",
                                "value": false,
                                "tooltip": "Enable to rescan the message.",
                                "type": "checkbox",
                                "name": "scan",
                                "required": false,
                                "editable": true,
                                "visible": true
                            }
                        ],
                        "Forward Message": [
                            {
                                "title": "Deleted Folder",
                                "description": "(Optional) Folder for deleting the quarantined messages. If specified, the folder for deleted messages must be for quarantined messages of the same type of module. For example, you cannot send deleted 'Spam' messages to a folder for deleted 'DLP Incidents', and vice versa.",
                                "type": "text",
                                "tooltip": "You cannot send deleted spam messages to a folder for deleted DLP Incidents, and vice versa.",
                                "name": "deletedfolder",
                                "required": false,
                                "editable": true,
                                "visible": true
                            },
                            {
                                "title": "Subject",
                                "description": "(Optional) Subject of the message that you want to forward. The subject that you specify here will overwrite the original subject of the message.",
                                "type": "text",
                                "tooltip": "It will overwrite the original subject for the message with a specified new subject.",
                                "name": "subject",
                                "required": false,
                                "editable": true,
                                "visible": true
                            },
                            {
                                "title": "From",
                                "description": "(Optional) Envelope address of the sender from whom you want to forward the message.\nNote: If this is not specified, the default \"From\" mailer address is used.",
                                "type": "text",
                                "name": "from",
                                "tooltip": "If not specified, the default mailer from address is used.",
                                "required": false,
                                "editable": true,
                                "visible": true
                            },
                            {
                                "title": "Header From",
                                "description": "(Optional) 'Header From' email address based on which you want to forward the message. \nNote: If this is not specified, the default \"From\" mailer address is used.",
                                "type": "text",
                                "name": "headerfrom",
                                "required": false,
                                "editable": true,
                                "visible": true,
                                "tooltip": "If not specified, the default mailer from address is used."
                            },
                            {
                                "title": "To",
                                "description": "(Optional) Comma-separated list of recipient email addresses to whom you want to forward the message.",
                                "type": "text",
                                "name": "to",
                                "required": false,
                                "editable": true,
                                "visible": true
                            },
                            {
                                "title": "Comment",
                                "description": "(Optional) Comment that you want to add to the message that you want to forward on the Proofpoint Email Gateway server.",
                                "type": "text",
                                "name": "comment",
                                "required": false,
                                "editable": true,
                                "visible": true
                            }
                        ],
                        "Move Message": [
                            {
                                "title": "Target Folder",
                                "description": "Folder to which you want to move the quarantined messages. The folder for moved messages must be for quarantined messages of the same type of module. For example, you cannot send deleted 'Spam' messages to a folder for deleted 'DLP Incidents', and vice versa.",
                                "type": "text",
                                "name": "targetfolder",
                                "required": true,
                                "editable": true,
                                "visible": true,
                                "tooltip": "Move is used for moving messages between folders."
                            }
                        ]
                    }
                },
                {
                    "title": "Quarantine Folder",
                    "type": "text",
                    "name": "folder",
                    "required": true,
                    "visible": true,
                    "editable": true
                },
                {
                    "title": "Local GUID",
                    "type": "text",
                    "name": "localguid",
                    "required": true,
                    "visible": true,
                    "editable": true
                }
            ],
            "output_schema": {},
            "open": false
        },
