{
    "name": "cofense-vision",
    "version": "1.0.1",
    "label": "Cofense Vision",
    "description": "Cofense Vision is a security solution designed to help organizations quickly detect, locate, and quarantine phishing emails across all employee inboxes.",
    "publisher": "",
    "icon_small_name": "small.png",
    "icon_large_name": "large.png",
    "id": 74,
    "configuration": {
        "fields": [
            {
                "title": "Server URL",
                "type": "text",
                "name": "hostname",
                "required": true,
                "visible": true,
                "editable": true,
                "tooltip": "Specify the URL of the Cofense Vision server to connect and perform automated operations."
            },
            {
                "title": "Username",
                "type": "text",
                "name": "username",
                "required": false,
                "visible": true,
                "editable": true,
                "tooltip": "Specify the name of the client to connect to the endpoint and perform automated operations"
            },
            {
                "title": "Password",
                "type": "password",
                "name": "password",
                "required": true,
                "visible": true,
                "editable": true,
                "tooltip": "Specify the password of the client to connect to the endpoint and perform automated operations"
            },
            {
                "title": "Verify SSL",
                "type": "checkbox",
                "name": "verify_ssl",
                "required": false,
                "visible": true,
                "editable": true,
                "value": true,
                "tooltip": "Specifies whether the SSL certificate for the server is to be verified. By default, this option is selected, i.e., set to true."
            }
        ]
    },
    "operations": [
        {
            "title": "Search Email",
            "operation": "search_email",
            "category": "investigation",
            "description": "Search for emails from Cofense Vision based on the email subject and sender email address you have provided.",
            "parameters": [
                {
                    "title": "Email Subject",
                    "type": "text",
                    "name": "emailSubject",
                    "required": true,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Specify the comma-separated email subjects based on which you want to retrieve emails."
                },
                {
                    "title": "Sender Email Address",
                    "type": "text",
                    "name": "senderEmailAddress",
                    "required": true,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Specify the comma-separated sender email address based on which you want to retrieve emails."
                }
            ],
            "annotation": "search_email",
            "enabled": true,
            "output_schema": {},
            "open": false
        },
        {
            "title": "Quarantine Email",
            "operation": "quarantine_email",
            "category": "investigation",
            "description": "Quarantine an emails in Cofense Vision based on the recipient address and internal message ID you have provided.",
            "parameters": [
                {
                    "title": "Recipient Address",
                    "type": "text",
                    "name": "recipientAddress",
                    "required": true,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Specify the comma-separated recipient email address of the account containing the emails to be quarantined."
                },
                {
                    "title": "Internet Message ID",
                    "type": "text",
                    "name": "internetMessageId",
                    "required": true,
                    "visible": true,
                    "editable": true,
                    "tooltip": "Specify the ID of any emails in that account to be quarantined, with each internetMessageId enclosed in angle brackets. For e.g <513C8CD8-E593-4DC4-82BF-6202E8AC95CB@example.com>"
                }
            ],
            "annotation": "quarantine_email",
            "enabled": true,
            "output_schema": {},
            "open": false
        },
        {
            "title": "Quarantine Email Pairs",
            "operation": "quarantine_email_pairs",
            "description": "Quarantine multiple emails in Cofense Vision based on multiple pairs of recipient address and internal message ID.",
            "parameters": [
                {
                    "title": "Email Pairs",
                    "type": "textarea",
                    "name": "emailPairs",
                    "required": false,
                    "visible": true,
                    "editable": true,
                    "value": null,
                    "tooltip": "Specify recipient address & internet message ID pairs in this format.\nExample: <IMmsgID1>:Email1, <IMmsgID2>:Email2, etc"
                }
            ],
            "open": false,
            "category": "investigation"
        }
    ],
    "category": [
        "Email Security"
    ],
    "contributor": "Hariharan Devaraj",
