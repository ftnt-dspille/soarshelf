                "operation": "list_content",
                "config": "",
                "params": {
                  "content_type": "Audit.Exchange",
                  "start_time": "{{ vars.steps.Extract_Affected_User.data.code_output.alert_created | default('', true) }}",
                  "end_time": "{{ get_current_datetime() }}"
                },
                "version": "1.0.1",
                "name": "Microsoft Management Activity API",
                "operationTitle": "MS Management Activity List Content",
                "step_variables": [],
                "pickFromTenant": false
              },
              "status": null,
              "top": "640",
