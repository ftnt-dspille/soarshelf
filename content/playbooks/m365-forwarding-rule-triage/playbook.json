                  "severity": "/api/3/picklists/b3c20a3a-ecfd-4adc-a225-0205968e6793",
                  "description": "Tracking alert for M365 forwarding-rule triage. Source alert: {{ vars.steps.Extract_Affected_User.data.code_output.alert_id }} User: {{ vars.steps.Extract_Affected_User.data.code_output.upn }}\n"
                },
                "collection": "/api/3/alerts"
              },
              "status": null,
