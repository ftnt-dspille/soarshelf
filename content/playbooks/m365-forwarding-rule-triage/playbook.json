                  "records": "{{ vars.steps.Create_Tracking_Alert['@id'] }}"
                }
              },
              "status": null,
              "top": "1420",
              "left": "200",
              "stepType": "/api/3/workflow_step_types/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
              "group": null,
