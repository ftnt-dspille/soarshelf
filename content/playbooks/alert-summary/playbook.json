              "uuid": "e8761a2f-9404-5925-b586-60c7c1f001b7"
            },
            {
              "@type": "WorkflowRoute",
              "name": "Count -> Result",
              "targetStep": "/api/3/workflow_steps/ff039635-25e4-5543-97d7-819d1a797fa6",
              "sourceStep": "/api/3/workflow_steps/7ddaa316-b361-5a44-8f87-fe55d092020a",
