                    "option": "Malicious",
                    "condition": "{{ vars.score | int >= vars.threshold | int }}",
                    "step_iri": "/api/3/workflow_steps/db367941-8106-5959-a042-5d5be83b9ab8",
                    "step_name": "Set severity to Critical"
                  },
                  {
                    "option": "Else",
                    "default": true,
                    "step_iri": "/api/3/workflow_steps/0edf4861-8530-5900-9b6a-b4a172467463",
                    "step_name": "Below the threshold"
                  }
                ]
              },
              "status": null,
              "top": "770",
