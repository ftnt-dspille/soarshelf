      "workflows": [
        {
          "@type": "Workflow",
          "name": "IP Reputation Check with VirusTotal",
          "aliasName": null,
          "tag": "",
          "recordTags": [],
          "description": "Run it on an alert. Looks up the alert's source IP on VirusTotal and sets severity to Critical when this many VirusTotal engines or more flag it as malicious (3 by default, set in the first step). Below the threshold the alert is left as it is. Private and invalid addresses are skipped.",
          "isActive": false,
          "debug": false,
          "singleRecordExecution": false,
          "remoteExecutableFlag": 0,
          "parameters": [],
          "synchronous": false,
          "triggerStep": "/api/3/workflow_steps/cebdd867-ca84-51fb-a41f-95b951119708",
          "steps": [
            {
              "@type": "WorkflowStep",
              "name": "Start",
              "description": null,
              "arguments": {
                "title": "Check source IP on VirusTotal",
                "resources": [
                  "alerts"
                ],
                "route": "4fd45d08-0913-5ea1-8410-42132de0e801",
                "inputVariables": [],
                "step_variables": {
                  "input": {
                    "params": [],
                    "records": "{{vars.input.records}}"
                  }
                },
                "triggerOnSource": true,
                "triggerOnReplicate": false,
                "noRecordExecution": false,
                "singleRecordExecution": true,
                "__triggerLimit": true,
                "executeButtonText": "Execute",
                "showToasterMessage": {
                  "visible": false,
                  "messageVisible": true
                },
                "displayConditions": {
                  "alerts": {
                    "sort": [],
                    "limit": 30,
                    "logic": "AND",
                    "filters": []
                  }
                }
              },
              "status": null,
              "top": "120",
              "left": "200",
              "stepType": "/api/3/workflow_step_types/f414d039-bb0d-4e59-9c39-a8f1e880b18a",
              "group": null,
              "uuid": "cebdd867-ca84-51fb-a41f-95b951119708"
            },
            {
              "@type": "WorkflowStep",
              "name": "Settings",
              "description": null,
              "arguments": {
                "threshold": 3,
                "source_ip": "{{ vars.input.records[0].sourceIp | default('', true) | string | trim }}"
              },
              "status": null,
              "top": "250",
              "left": "200",
              "stepType": "/api/3/workflow_step_types/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
              "group": null,
              "uuid": "ffee6d3b-b570-52db-905f-4408e2d0f8bf"
            },
            {
              "@type": "WorkflowStep",
              "name": "Is it a public IP",
              "description": null,
              "arguments": {
                "conditions": [
                  {
                    "option": "Public IP",
                    "condition": "{{ (vars.source_ip | ipaddr('public')) is string and '/' not in vars.source_ip }}",
                    "step_iri": "/api/3/workflow_steps/b884ba14-6c7d-5f24-a91a-06b6e4505c0c",
                    "step_name": "Check IP on VirusTotal"
                  },
                  {
                    "option": "Else",
                    "default": true,
                    "step_iri": "/api/3/workflow_steps/08310165-8bb6-57f8-a3c1-b1190845f774",
                    "step_name": "Not a public IP"
                  }
                ]
              },
              "status": null,
              "top": "380",
