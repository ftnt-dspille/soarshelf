{
  "name": "soarshelf-worker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.14.2",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply soarshelf --local",
    "migrate:remote": "wrangler d1 migrations apply soarshelf --remote",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261005.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.147.0"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=7.29.1",
      "sharp": ">=0.35.4"
    }
  }
}
